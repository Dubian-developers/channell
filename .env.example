PORT=3000
# Public HTTPS URL Safaricom can reach (e.g. your ngrok URL). No trailing slash.
PUBLIC_URL=https://your-subdomain.ngrok-free.app
# Random secrets. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me
ENC_KEY=64-hex-characters-here
